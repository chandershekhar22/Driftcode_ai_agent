{
  "name": "@driftcode/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.tsx",
  "bin": {
    "drift": "./bin/drift"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun --packages external",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@driftcode/shared": "workspace:*",
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "react": "^19",
    "react-router": "^8.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18"
  }
}
