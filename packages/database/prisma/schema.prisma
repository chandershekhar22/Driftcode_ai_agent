// Sessions and their transcripts.
//
// There is deliberately no User model yet - sessions are owned by whoever runs
// the server. Chapter 10 introduces Clerk auth and adds the owner relation;
// doing it now would mean carrying a fake user around for six chapters.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

/// plan is read-only; build lets the agent write files and run commands.
enum AgentMode {
  plan
  build
}

enum MessageRole {
  user
  assistant
  system
  /// The outcome of a tool the CLI ran, fed back to the model.
  tool
}

/// A person. Created from Clerk when auth is configured; otherwise there is
/// exactly one row, the local user, so sessions always have an owner and
/// turning auth on later does not orphan anything.
model User {
  id String @id @default(cuid())

  /// Null for the local user. Unique when present.
  clerkId String? @unique
  email   String?
  name    String?

  /// The Polar customer this account bills against. Null until billing is
  /// configured and this person has been registered with it.
  polarCustomerId String? @unique

  createdAt DateTime @default(now())
  sessions  Session[]
}

model Session {
  id    String @id @default(cuid())
  title String @default("New session")

  /// Model id at the time the session was created, e.g. "claude-opus-5".
  /// Stored as a string rather than an enum so retiring a model does not
  /// invalidate old rows.
  model String

  /// Absolute path of the project this session is working in.
  cwd String

  /// Whether the agent may change this project or only read it. Sessions open
  /// in plan mode: the safe default is the one that cannot damage anything.
  mode AgentMode @default(plan)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Nullable so the column could be added without a data migration; the
  /// server adopts any orphans into the local user on first use.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  // The session list is always one owner's, most recently touched first.
  @@index([userId, updatedAt(sort: Desc)])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  /// On an assistant message: the tool calls it made, as stored ToolCall
  /// objects. Kept structurally rather than as prose so the next request can
  /// replay them to the model in the shape it expects.
  toolCalls Json?

  /// On a tool message: which call it answers.
  toolCallId String?
  toolName   String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Transcripts are always read in order for one session.
  @@index([sessionId, createdAt])
}
