{
  "name": "driftcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "typecheck": "bun run --filter '*' typecheck",
    "build:cli": "bun run --filter @driftcode/cli build",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "test": "bun test"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
