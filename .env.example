# ---------------------------------------------------------------------------
# driftcode environment
# Copy this file to `.env` and fill in the values as each chapter needs them.
# `.env` is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# --- Chapter 1: server ---------------------------------------------------
# Port the API server listens on, and where the CLI expects to find it.
PORT=4000
DRIFT_API_URL=http://localhost:4000

# --- Chapter 4: database -------------------------------------------------
# Postgres connection string. Neon (neon.tech) has a free tier.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Chapter 5: the model ------------------------------------------------
# Anthropic API key from console.anthropic.com -> API keys.
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Chapter 10: auth ----------------------------------------------------
# CLERK_SECRET_KEY="sk_test_..."
# CLERK_PUBLISHABLE_KEY="pk_test_..."

# --- Chapter 11: billing -------------------------------------------------
# POLAR_ACCESS_TOKEN="polar_oat_..."
# POLAR_WEBHOOK_SECRET="..."
