# ---------------------------------------------------------------------------
# driftcode environment
# Copy this file to `.env` and fill in the values as each chapter needs them.
# `.env` is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# --- Chapter 1: server ---------------------------------------------------
PORT=4000
DRIFT_API_URL=http://localhost:4000

# --- Chapter 4: database -------------------------------------------------
# Postgres connection string. Neon (neon.tech) has a free tier.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Chapter 5: the models -----------------------------------------------
# At least one of these is required. The server reports which models it can
# run at GET /models, and the picker greys out the rest with the reason.

# Anthropic key from console.anthropic.com -> API keys.
# ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI key. Also add a model entry to packages/shared/src/models.ts with
# provider: "openai" to make it selectable.
# OPENAI_API_KEY="sk-..."

# --- Chapter 10: auth ----------------------------------------------------
# Clerk OAuth application (Configure > Developers > OAuth applications).
# Scopes: openid, email, profile, offline_access. Public + consent screen on.
# Redirect URI for local dev: http://localhost:4000/auth/callback
# CLERK_OAUTH_CLIENT_ID=""
# CLERK_OAUTH_CLIENT_SECRET=""
# CLERK_FRONTEND_API=""
# CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""
# Signs the session token the server hands the CLI after OAuth completes.
# Any long random string - generate with: openssl rand -hex 32
# JWT_SECRET=""

# --- Chapter 11: billing -------------------------------------------------
# POLAR_ACCESS_TOKEN=""
# POLAR_PRODUCT_ID=""
# POLAR_CREDITS_METER_ID=""
# POLAR_SERVER=sandbox
